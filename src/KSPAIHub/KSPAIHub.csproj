<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>0.4.0</Version>
    <Authors>fubuki11st</Authors>
    <Company>fubuki11st</Company>
    <Copyright>Copyright (c) 2026 fubuki11st</Copyright>
    <RepositoryUrl>https://github.com/fubuki11/KSP-AIHub</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AssemblyName>KSPAIHub</AssemblyName>
    <KspRoot Condition="'$(KspRoot)' == ''">$(KSP_ROOT)</KspRoot>
    <KspManaged>$(KspRoot)/KSP_x64_Data/Managed</KspManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(KspManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KspManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KspManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KspManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(KspManaged)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckKsp" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KspManaged)/Assembly-CSharp.dll')" Text="Provide /p:KspRoot for KSP 1.12.5." />
  </Target>
</Project>
